#!/bin/sh
set -eu
# Regenerates the word lists shipped for languages macOS has a keyboard for but no spell-checking
# dictionary. Each comes from the Leipzig Corpora Collection (CC BY 4.0), built from Wikipedia or news
# text, and keeps the most frequent words made only of letters. Needs curl, tar and perl.

cd "$(dirname "$0")/.."
out="Sources/WorldKey/WordLists"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# language code, Swift name, Leipzig corpus, source text and its licence
lists="th thai tha_wikipedia_2021_10K Wikipedia
ka georgian kat_wikipedia_2021_10K Wikipedia
hy armenian hye_wikipedia_2021_10K Wikipedia
am amharic amh_wikipedia_2021_10K Wikipedia
az azerbaijani aze_wikipedia_2021_10K Wikipedia
be belarusian bel_wikipedia_2021_10K Wikipedia
bn bengali ben_wikipedia_2021_10K Wikipedia
cy welsh cym_wikipedia_2021_10K Wikipedia
et estonian est_newscrawl_2017_10K news
fa persian pes_wikipedia_2021_10K Wikipedia
gu gujarati guj_wikipedia_2021_10K Wikipedia
hr croatian hrv_wikipedia_2021_10K Wikipedia
kk kazakh kaz_wikipedia_2021_10K Wikipedia
kn kannada kan_wikipedia_2021_10K Wikipedia
ky kyrgyz kir_wikipedia_2021_10K Wikipedia
lv latvian lav_newscrawl_2016_10K news
mk macedonian mkd_wikipedia_2021_10K Wikipedia
ml malayalam mal_wikipedia_2021_10K Wikipedia
mn mongolian mon_wikipedia_2021_10K Wikipedia
mr marathi mar_wikipedia_2021_10K Wikipedia
mt maltese mlt_wikipedia_2021_10K Wikipedia
or odia ori_wikipedia_2021_10K Wikipedia
si sinhala sin_wikipedia_2021_10K Wikipedia
sk slovak slk_wikipedia_2021_10K Wikipedia
sq albanian sqi_wikipedia_2021_10K Wikipedia
sr serbian srp_wikipedia_2021_10K Wikipedia
ur urdu urd_wikipedia_2021_10K Wikipedia"

index="$work/index.swift"
{
    echo "// Generated by scripts/wordlists. Regenerate rather than edit."
    echo ""
    echo "extension WordLists {"
    echo "    /// The shipped list's text for a language, one word a line."
    echo "    static func text(_ language: String) -> String? {"
    echo "        switch language {"
} >"$index"

echo "$lists" | while read -r code name corpus source; do
    echo "==> $corpus"
    curl -sSf "https://downloads.wortschatz-leipzig.de/corpora/$corpus.tar.gz" | tar -xz -C "$work"
    words="$work/$corpus/$corpus-words.txt"
    [ -f "$words" ] || {
        echo "wordlists: $corpus has no words file; the corpus layout may have changed" >&2
        exit 1
    }
    licence="CC BY-SA 4.0"
    [ "$source" = news ] && licence="the publishers' own terms, distributed by Leipzig as CC BY 4.0"
    file="$out/$(echo "$name" | perl -pe 's/^(.)/\u$1/').swift"
    {
        echo "// Generated by scripts/wordlists. Regenerate rather than edit."
        echo "// Source: Leipzig Corpora Collection, $corpus (https://wortschatz.uni-leipzig.de),"
        echo "// CC BY 4.0, from $source text ($licence). The 8,000 most frequent words seen"
        echo "// at least twice, letters only, lowercased."
        echo ""
        echo "extension WordLists {"
        echo "    static let $name = \"\"\""
        # Columns: id, word, frequency. Keep letter-and-mark words of two or more characters.
        perl -CSD -F'\t' -lane '
            next unless $F[2] >= 2;
            my $w = lc $F[1];
            next unless $w =~ /^[\p{L}\p{M}]{2,}$/;
            next if $seen{$w}++;
            print "$F[2]\t$w";
        ' "$words" | sort -t "$(printf '\t')" -k1,1nr | head -n 8000 | cut -f2 | sed 's/^/        /'
        echo "        \"\"\""
        echo "}"
    } >"$file"
    echo "        case \"$code\": $name" >>"$index"
done

{
    echo "        default: nil"
    echo "        }"
    echo "    }"
    echo "}"
} >>"$index"
cp "$index" "$out/Index.swift"
echo "==> wrote $out"
