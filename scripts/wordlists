#!/bin/sh
set -eu
# Regenerates the word lists shipped for languages macOS has no spell-checking dictionary for.
# Each comes from the Leipzig Corpora Collection (CC BY 4.0), built from Wikipedia text (CC BY-SA 4.0),
# and keeps the most frequent words made only of letters. Needs curl, tar and perl.

cd "$(dirname "$0")/.."
out="Sources/WorldKey/WordLists"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# language code, Swift name, Leipzig corpus
lists="th thai tha_wikipedia_2021_10K
ka georgian kat_wikipedia_2021_10K
hy armenian hye_wikipedia_2021_10K"

echo "$lists" | while read -r code name corpus; do
    echo "==> $corpus"
    curl -sSf "https://downloads.wortschatz-leipzig.de/corpora/$corpus.tar.gz" | tar -xz -C "$work"
    words="$work/$corpus/$corpus-words.txt"
    [ -f "$words" ] || {
        echo "wordlists: $corpus has no words file; the corpus layout may have changed" >&2
        exit 1
    }
    {
        echo "// Generated by scripts/wordlists. Regenerate rather than edit."
        echo "// Source: Leipzig Corpora Collection, $corpus (https://wortschatz.uni-leipzig.de),"
        echo "// CC BY 4.0, from Wikipedia text (CC BY-SA 4.0). The 8,000 most frequent words seen at"
        echo "// least twice, letters only, lowercased."
        echo ""
        echo "extension WordLists {"
        echo "    static let $name = \"\"\""
        # Columns: id, word, frequency. Keep letter-and-mark words of two or more characters.
        perl -CSD -F'\t' -lane '
            next unless $F[2] >= 2;
            my $w = lc $F[1];
            next unless $w =~ /^[\p{L}\p{M}]{2,}$/;
            next if $seen{$w}++;
            print "$F[2]\t$w";
        ' "$words" | sort -t "$(printf '\t')" -k1,1nr | head -n 8000 | cut -f2 | sed 's/^/        /'
        echo "        \"\"\""
        echo "}"
    } >"$out/$(echo "$name" | perl -pe 's/^(.)/\u$1/').swift"
done
echo "==> wrote $out"
